# Opik isolated deployment configuration — example template.
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# NOTE: changing DB credentials after first start requires wiping volumes:
#   docker compose -p opik -f docker-compose.yaml -f docker-compose.isolated.yaml \
#     --profile opik down -v
# This deletes all Opik data.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=opik
MYSQL_USER=opik
MYSQL_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- ClickHouse ---
CLICKHOUSE_DB=opik
CLICKHOUSE_USER=opik
CLICKHOUSE_PASSWORD=change-me

# --- MinIO (S3) ---
MINIO_ROOT_USER=opikminio
MINIO_ROOT_PASSWORD=change-me-min-20-chars

# --- Auth gate (nginx Basic Auth in front of frontend) ---
# Set FLAVOR=protected to enable the auth gate (uses nginx_protected_local.conf).
# Set FLAVOR=default to disable.
# Generate the htpasswd file alongside this .env:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password' > .htpasswd
OPIK_FRONTEND_FLAVOR=protected
OPIK_AUTH_USER=admin
OPIK_AUTH_PASSWORD=change-me

# --- LLM API keys (optional, leave blank if unused) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
